# Get an API key at https://resend.com after creating an account.
# Add this same variable in Vercel: Project Settings -> Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Places (New) key for address suggestions on the quote and EV charger forms.
# Restrict it to the "Places API (New)" and to the site's domains (HTTP referrers) in Google Cloud.
# Without it the address boxes still work as plain text fields.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Optional: send website enquiries (quote form, EV shop, contact form, chat) into the Sunflow CRM as new customers.
# Use the CRM's Supabase project URL and its service_role key (secret - server only, never NEXT_PUBLIC_).
CRM_SUPABASE_URL=
CRM_SUPABASE_SERVICE_ROLE_KEY=
