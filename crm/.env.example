# --- Shared by the app (safe to expose; these two are public by design) ---
# Supabase: Project Settings -> API. Leave blank to run in "this device only" mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (Vercel -> Settings -> Environment Variables). Never prefix with VITE_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Address specials are sent from. Must be on a domain verified in Resend.
MAIL_FROM="Sunflow Energy Solutions <specials@sunflowenergysolutions.com.au>"
MAIL_REPLY_TO=info@sunflowenergysolutions.com.au
# Any long random string. Signs the unsubscribe links.
UNSUBSCRIBE_SECRET=
# The CRM's public address, e.g. https://crm.sunflowenergysolutions.com.au
APP_URL=

# --- Xero (optional). developer.xero.com -> New app. Redirect URI: <APP_URL>/api/xero-callback ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Your sales account code in Xero (default 200) and GST-on-income tax type (default OUTPUT)
XERO_SALES_ACCOUNT_CODE=
XERO_TAX_TYPE=

# --- Enquiries from ads and other sources: POST leads to <APP_URL>/api/lead with header  x-api-key: <this value> ---
# Any long random string.
LEAD_WEBHOOK_SECRET=

# --- Pylon (optional): app.getpylon.com -> Settings -> API ---
# Token with read access to projects and designs
PYLON_API_TOKEN=
# Secret shown when you create the webhook destination (URL: <APP_URL>/api/pylon-webhook)
PYLON_WEBHOOK_SECRET=

# --- Address suggestions in the customer form (optional) ---
# Google Maps Platform key with "Places API (New)" enabled, restricted to this CRM's address (HTTP referrers).
# Can be the same key the website uses once the CRM address is added to its allowed referrers. Leave blank for a plain address box.
VITE_GOOGLE_PLACES_API_KEY=
