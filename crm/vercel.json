{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/pylon-import.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/daily-report",
      "schedule": "0 8 * * *"
    }
  ]
}
